# Copy to .env and edit. NEVER commit .env.

POSTGRES_DB=dogfood
POSTGRES_USER=dogfood
POSTGRES_PASSWORD=dogfood
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,frontend,nginx

# Comma-separated origins allowed for unsafe requests when the app is served
# from another origin (proxies, share tunnels). e.g. https://xyz.trycloudflare.com
CSRF_TRUSTED_ORIGINS=

LOG_LEVEL=INFO

# --- Observability stack ---------------------------------------------------
# How long Prometheus keeps metrics on local disk before evicting.
PROMETHEUS_RETENTION=15d

# Grafana admin login. Override before going to production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alertmanager webhook receivers. Point these at Slack/PagerDuty/etc.
# Default (httpbin) only useful for local poking.
ALERT_WEBHOOK_URL=http://127.0.0.1:5001/alerts
ALERT_WEBHOOK_URL_CRITICAL=http://127.0.0.1:5001/alerts

# --- Remote Prometheus (commented; flip when the company gives creds) ---
# REMOTE_WRITE_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/v1/push
# REMOTE_WRITE_USERNAME=<instance_id>
# REMOTE_WRITE_PASSWORD=<api_key>
